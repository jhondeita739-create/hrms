NEXT_PUBLIC_SUPABASE_URL=https://vofkqzqueigzasppstfu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preferred for server-only public application processing (sb_secret_...).
SUPABASE_SECRET_KEY=your-secret-key
# Legacy fallback if your project has not migrated to secret keys yet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP for applicant decisions and interview notifications.
# Use a Google App Password, not your normal Gmail password. Keep these server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM="HRMS Careers <your-gmail-address@gmail.com>"
